# Copy to .env and fill with your own Lovable Cloud / Supabase values.
# NEVER commit the real .env — only publishable keys are safe in the client bundle,
# and secrets (service role, DB URL) must live in Lovable Cloud secrets.

VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Server-only (mirrors of the above for SSR). Same publishable key — no secrets here.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
SUPABASE_PROJECT_ID="your-project-id"
